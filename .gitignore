# ===== 依赖（体积巨大，绝不入库）=====
node_modules/

# ===== Python 缓存 / 虚拟环境 / 构建 =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ===== 密钥 / 环境变量（含数据库与 API 密钥，切勿上传）=====
.env
*.env
.env.*

# ===== 运行日志 / 错误输出 =====
*.log
*.err

# ===== 构建产物 =====
dist/
build/
*.tsbuildinfo
.vite/

# ===== IDE / 操作系统文件 =====
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ===== CodeBuddy 项目数据（非源码）=====
.codebuddy/

# ===== 误产生的垃圾文件 =====
/$null
